---
/**
 * Illustration de la charte, injectée en SVG inline.
 * `recolor` remplace les verts de la charte par `currentColor`
 * (utile pour afficher un pictogramme sombre sur fond sombre).
 */
interface Props {
  name: string;
  class?: string;
  recolor?: boolean;
  title?: string;
}
const { name, class: className = '', recolor = false, title } = Astro.props;

const files = import.meta.glob('../assets/brand/illus-*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const key = Object.keys(files).find((k) => k.endsWith(`illus-${name}.svg`));
if (!key) throw new Error(`Illustration introuvable : ${name}`);

let svg = files[key]
  .replace(/<\?xml[^>]*>/, '')
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/\s(id|data-name)="[^"]*"/g, '')
  .replace(/class="(cls-\d+)"/g, `class="il-${name}-$1"`)
  .replace(/\.(cls-\d+)/g, `.il-${name}-$1`);

if (recolor) {
  svg = svg.replace(/#00363[0-9a-f]|#00373[0-9a-f]|#f1ebdf/gi, 'currentColor');
}

svg = svg.replace('<svg', `<svg class="illus ${className}" aria-hidden="${title ? 'false' : 'true'}" role="img" focusable="false"`);
if (title) svg = svg.replace(/(<svg[^>]*>)/, `$1<title>${title}</title>`);
---

<Fragment set:html={svg} />
