---
import { t } from '../content/i18n';
import { path, type Lang } from '../content/routes';
import { CONTACT, HOURS, BOOKING } from '../content/site';
import Illus from './Illus.astro';

interface Props {
  lang: Lang;
  /** Affiche la carte Google Maps (iframe, chargée en lazy). */
  map?: boolean;
  title?: string;
}
const { lang, map = true, title } = Astro.props;
const d = t(lang);
const bookHref = BOOKING.externalUrl || path('book', lang);

/** Horaires regroupés pour affichage (ordre lundi → dimanche). */
const order = [1, 2, 3, 4, 5, 6, 0];
const rows = order.map((day) => {
  const h = HOURS.find((x) => x.day === day)!;
  const fmt = (s: string) => (lang === 'fr' ? s.replace(':00', ' h').replace('00 h', 'minuit') : s);
  return { label: d.venue.days[day], value: h.open ? `${fmt(h.open)} – ${fmt(h.close!)}` : d.venue.closed, closed: !h.open };
});

const lineColors: Record<string, [string, string]> = {
  '3': ['#9b993a', '#012522'],
  '4': ['#bb4d98', '#ffffff'],
  '5': ['#f28e42', '#012522'],
  '7': ['#f3a4ba', '#012522'],
  '8': ['#ceadd2', '#012522'],
  '9': ['#b6bd00', '#012522'],
  '11': ['#8c5e24', '#ffffff'],
};
---

<section class="section theme-dark venue" id="venue">
  <div class="ornament venue__ornament"><Illus name="green-vegetal" /></div>
  <div class="container">
    <div class="section-head section-head--center">
      <h2>{title ?? d.venue.title}</h2>
      <p class="lead venue__address">
        {d.venue.addressLine}<br />
        <span class="muted">{d.venue.nearby}</span>
      </p>
    </div>

    <div class:list={['venue__grid', { 'venue__grid--nomap': !map }]}>
      {map && (
        <div class="venue__map">
          <iframe
            src={CONTACT.mapsEmbedUrl}
            title="Google Maps"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
          <a class="btn btn--peach btn--small venue__maplink" href={CONTACT.mapsUrl} target="_blank" rel="noopener">{d.venue.mapCta}</a>
        </div>
      )}

      <div class="venue__cards">
        <div class="card">
          <h3>{d.venue.metroTitle}</h3>
          <ul class="venue__metro">
            {d.venue.metro.map((m) => (
              <li>
                <span class="venue__lines">
                  {m.lines.map((l) => (
                    <span class="line" style={`--line:${(lineColors[l] ?? ['#999', '#012522'])[0]};--line-text:${(lineColors[l] ?? ['#999', '#012522'])[1]}`}>{l}</span>
                  ))}
                </span>
                <span class="venue__station">{m.name}</span>
                <span class="venue__walk">{m.walk}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="card">
          <h3>{d.venue.hoursTitle}</h3>
          <ul class="venue__hours">
            {rows.map((r) => (
              <li class:list={{ closed: r.closed }}>
                <span>{r.label}</span>
                <span>{r.value}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="card">
          <h3>{d.venue.practicalTitle}</h3>
          <ul class="check-list">
            {d.venue.practical.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      </div>
    </div>

    <p class="venue__cta">
      <a class="btn btn--peach" href={bookHref}>{d.venue.cta}</a>
    </p>
  </div>
</section>

<style>
  .venue {
    overflow: hidden;
  }
  .venue__ornament {
    width: 420px;
    right: -120px;
    top: 40px;
    opacity: 0.25;
  }
  .venue__address {
    text-align: center;
  }
  .venue__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(1rem, 2.5vw, 2rem);
    position: relative;
    z-index: 1;
  }
  .venue__grid--nomap {
    grid-template-columns: 1fr;
  }
  .venue__grid--nomap .venue__cards {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .venue__map {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    min-height: 420px;
    background: var(--green-700);
  }
  .venue__map iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    filter: saturate(0.85);
  }
  .venue__maplink {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
  }
  .venue__cards {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .card h3 {
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }
  .venue__metro,
  .venue__hours {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .venue__metro li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
  }
  .venue__lines {
    display: inline-flex;
    gap: 0.25rem;
  }
  .line {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--line);
    color: var(--line-text, var(--green-950));
    font-size: 0.8rem;
    font-weight: 700;
  }
  .venue__walk {
    opacity: 0.75;
    font-size: 0.95rem;
  }
  .venue__hours li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .venue__hours li.closed {
    opacity: 0.6;
  }
  .venue__cta {
    text-align: center;
    margin-top: clamp(2rem, 4vw, 3rem);
    position: relative;
    z-index: 1;
  }
  @media (max-width: 900px) {
    .venue__grid,
    .venue__grid--nomap .venue__cards {
      grid-template-columns: 1fr;
    }
    .venue__map {
      min-height: 320px;
    }
  }
</style>
