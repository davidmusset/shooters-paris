---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Venue from '../components/Venue.astro';
import { t } from '../content/i18n';
import type { Lang } from '../content/routes';
import { CONTACT } from '../content/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const f = d.contactPage.form;
---

<Base lang={lang} title={d.meta.contact.title} description={d.meta.contact.description} routeKey="contact">
  <PageHero title={d.contactPage.title} lead={d.contactPage.lead} compact />

  <section class="section theme-cream">
    <div class="container contact__grid">
      <form class="contact-form card" method="post" action="/api/contact" data-contact-form data-lang={lang} novalidate>
        <div class="field-row">
          <label class="field">
            <span>{f.name}</span>
            <input type="text" name="name" required autocomplete="name" />
          </label>
          <label class="field">
            <span>{f.email}</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>
        </div>
        <div class="field-row">
          <label class="field">
            <span>{f.phone}</span>
            <input type="tel" name="phone" autocomplete="tel" />
          </label>
          <label class="field">
            <span>{f.company}</span>
            <input type="text" name="company" autocomplete="organization" />
          </label>
        </div>
        <div class="field-row">
          <label class="field">
            <span>{f.occasion}</span>
            <select name="occasion">
              {f.occasions.map((o) => <option value={o}>{o}</option>)}
            </select>
          </label>
          <label class="field">
            <span>{f.date}</span>
            <input type="date" name="date" />
          </label>
          <label class="field">
            <span>{f.people}</span>
            <input type="number" name="people" min="1" max="200" inputmode="numeric" />
          </label>
        </div>
        <label class="field">
          <span>{f.message}</span>
          <textarea name="message" rows="5" required></textarea>
        </label>
        <label class="consent">
          <input type="checkbox" name="consent" required />
          <span>{f.consent}</span>
        </label>
        <!-- piège à robots : doit rester vide -->
        <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
        <input type="hidden" name="lang" value={lang} />
        <div class="contact-form__actions">
          <button class="btn btn--peach" type="submit" data-submit>{f.submit}</button>
          <p class="contact-form__status" role="status" aria-live="polite" data-status></p>
        </div>
      </form>

      <aside class="contact__aside">
        <h2>{d.contactPage.directTitle}</h2>
        <p>{d.contactPage.directText}</p>
        <p><a class="btn btn--green" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></p>
        {CONTACT.phone && <p><a href={`tel:${CONTACT.phone.replace(/\s/g, '')}`}>{CONTACT.phone}</a></p>}
      </aside>
    </div>
  </section>

  <Venue lang={lang} map={false} />
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const lang = form.dataset.lang === 'en' ? 'en' : 'fr';
    const msg = {
      fr: { sending: 'Envoi en cours…', success: 'Demande envoyée. Nous revenons vers vous sous 24 h ouvrées.', error: 'L’envoi a échoué. Écrivez-nous directement à', invalid: 'Merci de remplir les champs obligatoires.' },
      en: { sending: 'Sending…', success: 'Request sent. We will get back to you within one business day.', error: 'Sending failed. Email us directly at', invalid: 'Please fill in the required fields.' },
    }[lang];
    const email = 'paris@theshootingbar.com';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        status.textContent = msg.invalid;
        return;
      }
      submit.disabled = true;
      status.textContent = msg.sending;
      try {
        const data = Object.fromEntries(new FormData(form).entries());
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error(String(res.status));
        status.textContent = msg.success;
        form.reset();
      } catch {
        status.innerHTML = `${msg.error} <a href="mailto:${email}">${email}</a>.`;
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
  }
  .contact-form {
    display: grid;
    gap: 1.1rem;
  }
  .field-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }
  .field {
    display: grid;
    gap: 0.35rem;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .field input,
  .field select,
  .field textarea {
    font: inherit;
    font-weight: 400;
    padding: 0.7rem 0.9rem;
    border: 1.5px solid var(--cream-300);
    border-radius: var(--radius-sm);
    background: var(--cream-100);
    color: var(--ink);
    width: 100%;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: 3px solid rgba(255, 119, 132, 0.45);
    border-color: var(--peach);
  }
  .consent {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: 0.95rem;
  }
  .consent input {
    margin-top: 0.3rem;
    accent-color: var(--green);
  }
  .hp {
    position: absolute;
    left: -9999px;
    opacity: 0;
  }
  .contact-form__actions {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }
  .contact-form__status {
    font-weight: 600;
    min-height: 1.5em;
  }
  .contact__aside {
    display: grid;
    gap: 1rem;
    position: sticky;
    top: 6.5rem;
  }
  .contact__aside h2 {
    font-size: 1.7rem;
  }
  @media (max-width: 900px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
    .contact__aside {
      position: static;
    }
  }
</style>
