---
import { t } from '../content/i18n';
import { path, type Lang } from '../content/routes';
import { BOOKING } from '../content/site';
import Illus from './Illus.astro';

interface Props {
  lang: Lang;
  title?: string;
  text?: string;
}
const { lang, title, text } = Astro.props;
const d = t(lang);
const bookHref = BOOKING.externalUrl || path('book', lang);
---

<section class="section section--tight theme-mint cta-band">
  <div class="ornament cta-band__left"><Illus name="leaves-left" /></div>
  <div class="ornament cta-band__right"><Illus name="leaves-right" /></div>
  <div class="container cta-band__inner">
    <h2>{title ?? d.ctaBand.title}</h2>
    <p class="lead">{text ?? d.ctaBand.text}</p>
    <div class="cta-band__actions">
      <a class="btn btn--green" href={bookHref}>{d.ctaBand.book}</a>
      <a class="btn btn--outline" href={path('contact', lang)}>{d.ctaBand.contact}</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    overflow: hidden;
  }
  .cta-band__inner {
    text-align: center;
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1rem;
    justify-items: center;
  }
  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 0.5rem;
  }
  .cta-band__left,
  .cta-band__right {
    width: 220px;
    top: -20px;
    opacity: 0.9;
    filter: brightness(0.55) saturate(1.2);
  }
  .cta-band__left {
    left: -40px;
  }
  .cta-band__right {
    right: -40px;
  }
  @media (max-width: 700px) {
    .cta-band__left,
    .cta-band__right {
      width: 120px;
      opacity: 0.4;
    }
  }
</style>
