---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-vertical-blanc.png';
import { t } from '../content/i18n';
import { path, type Lang } from '../content/routes';
import { CONTACT, SOCIAL, BOOKING } from '../content/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const year = new Date().getFullYear();
const bookHref = BOOKING.externalUrl || path('book', lang);
---

<footer class="site-footer theme-deep">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <Image src={logo} alt="Shooters, the world's first shooting range bar" width="220" height="300" />
      <p class="site-footer__tagline">{d.footer.tagline}</p>
      <address>
        {CONTACT.address.street}<br />
        {CONTACT.address.postalCode} {CONTACT.address.city}<br />
        <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        {CONTACT.phone && <><br /><a href={`tel:${CONTACT.phone.replace(/\s/g, '')}`}>{CONTACT.phone}</a></>}
      </address>
      {SOCIAL.instagram && (
        <a class="site-footer__social" href={SOCIAL.instagram} rel="noopener" target="_blank" aria-label={d.footer.instagram}>
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg>
        </a>
      )}
    </div>

    <div>
      <h2 class="site-footer__title">{d.footer.hoursTitle}</h2>
      <ul class="site-footer__list">
        {d.venue.hoursSummary.map((h) => <li>{h}</li>)}
      </ul>
    </div>

    <div>
      <h2 class="site-footer__title">{d.footer.navTitle}</h2>
      <ul class="site-footer__list">
        <li><a href={path('concept', lang)}>{d.nav.concept}</a></li>
        <li><a href={path('occasions', lang)}>{d.nav.occasions}</a></li>
        <li><a href={path('pricing', lang)}>{d.nav.pricing}</a></li>
        <li><a href={path('menu', lang)}>{d.nav.menu}</a></li>
        <li><a href={path('venue', lang)}>{d.nav.venue}</a></li>
        <li><a href={bookHref}>{d.nav.book}</a></li>
      </ul>
    </div>

    <div>
      <h2 class="site-footer__title">{d.footer.infoTitle}</h2>
      <ul class="site-footer__list">
        <li><a href={path('faq', lang)}>{d.nav.faq}</a></li>
        <li><a href={path('contact', lang)}>{d.nav.contact}</a></li>
        <li><a href={path('legal', lang)}>{d.footer.legal}</a></li>
        <li><a href={path('privacy', lang)}>{d.footer.privacy}</a></li>
        <li><a href={path('terms', lang)}>{d.footer.terms}</a></li>
      </ul>
    </div>
  </div>
  <div class="container site-footer__bottom">
    <p>© Shooters Paris {year}. {d.footer.rights}.</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: calc(var(--section) * 0.8) 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 2.5rem;
  }
  .site-footer__brand img {
    width: 150px;
    height: auto;
    margin-bottom: 1.25rem;
  }
  .site-footer__tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.2rem;
    margin-bottom: 0.75rem;
  }
  address {
    font-style: normal;
    line-height: 1.6;
    opacity: 0.85;
  }
  address a {
    text-decoration: none;
  }
  address a:hover {
    text-decoration: underline;
  }
  .site-footer__social {
    display: inline-flex;
    margin-top: 1.25rem;
    color: var(--mint);
  }
  .site-footer__title {
    font-family: var(--font-caps);
    font-style: normal;
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mint);
    margin-bottom: 1rem;
  }
  .site-footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    opacity: 0.88;
  }
  .site-footer__list a {
    text-decoration: none;
  }
  .site-footer__list a:hover {
    text-decoration: underline;
    text-decoration-color: var(--peach);
  }
  .site-footer__bottom {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.9rem;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
