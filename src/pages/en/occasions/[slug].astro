---
import OccasionView from '../../../views/OccasionView.astro';
import { OCCASION_SLUGS } from '../../../content/routes';

export function getStaticPaths() {
  return Object.entries(OCCASION_SLUGS.en).map(([slug, occasion]) => ({ params: { slug }, props: { occasion } }));
}
const { occasion } = Astro.props;
---
<OccasionView lang="en" occasion={occasion} />
