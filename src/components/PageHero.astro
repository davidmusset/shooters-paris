---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  lead?: string;
  image?: ImageMetadata;
  alt?: string;
  /** Hauteur réduite (pages utilitaires). */
  compact?: boolean;
}
const { title, lead, image, alt = '', compact = false } = Astro.props;
---

<section class:list={['page-hero', { 'page-hero--compact': compact, 'page-hero--image': !!image }]}>
  {image && (
    <Picture src={image} alt={alt} widths={[640, 1024, 1600, 2000]} sizes="100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" class="page-hero__img" />
  )}
  <div class="page-hero__shade" aria-hidden="true"></div>
  <div class="container page-hero__content">
    <h1 class="rise">{title}</h1>
    {lead && <p class="lead rise rise--2">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    background: var(--green-950);
    display: grid;
    align-items: end;
    min-height: 46svh;
    overflow: hidden;
  }
  .page-hero--image {
    min-height: min(64svh, 720px);
  }
  .page-hero--compact {
    min-height: 0;
  }
  .page-hero :global(picture),
  .page-hero :global(.page-hero__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .page-hero :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }
  .page-hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(1, 37, 34, 0.96) 0%, rgba(1, 37, 34, 0.6) 50%, rgba(1, 37, 34, 0.25) 100%);
  }
  .page-hero:not(.page-hero--image) .page-hero__shade {
    background: radial-gradient(80% 120% at 100% 0%, rgba(147, 210, 183, 0.12), transparent 60%);
  }
  .page-hero__content {
    position: relative;
    z-index: 1;
    padding-block: clamp(7rem, 11vw, 9rem) clamp(2.5rem, 5vw, 4rem);
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .page-hero--compact .page-hero__content {
    padding-block: clamp(6.5rem, 9vw, 7.5rem) clamp(2rem, 4vw, 3rem);
  }
  .page-hero__content h1 {
    max-width: 16ch;
  }
</style>
